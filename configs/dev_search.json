{
  "schema_version": "1.0",
  "experiment_name": "claimsem_dev_search",
  "description": "Development-only selection, ablation, and robustness analysis",
  "global_seed": 42,
  "paths": {
    "data_root": "${CLAIMSEM_DATA_ROOT}",
    "dev_records": "${CLAIMSEM_DATA_ROOT}/processed/dev_records.pkl",
    "dev_feature_dir": "${CLAIMSEM_DATA_ROOT}/processed/token_features/full/dev",
    "output_root": "${CLAIMSEM_OUTPUT_ROOT}/dev_search"
  },
  "data": {
    "patent_id_field": "patent_id",
    "claims_field": "claims",
    "claim_id_field": "claim_id",
    "claim_text_field": "text",
    "parent_ids_field": "parent_ids",
    "cpc_field": "cpc",
    "strict_alignment": true,
    "validate_dependencies": true,
    "remove_invalid_references": true,
    "require_acyclic_graph": true
  },
  "features": {
    "mode": "cached_shards",
    "embedding_dim": 768,
    "dtype": "float32",
    "verify_cache_provenance": true
  },
  "encoder": {
    "model_id": "${CLAIMSEM_ENCODER_ID}",
    "revision": "${CLAIMSEM_ENCODER_REVISION}",
    "frozen": true,
    "max_length": 512,
    "batch_size": 64,
    "mixed_precision": true,
    "pooling": "masked_mean",
    "output_dtype": "float32"
  },
  "development_split": {
    "strategy": "fixed_random_split",
    "tune_fraction": 0.7,
    "holdout_fraction": 0.3,
    "random_state": 42,
    "save_indices": true
  },
  "pooling": {
    "method": "root_depth_aware",
    "root_weight": 12.0,
    "depth_decay": 0.1
  },
  "search_space": {
    "root_weights": [
      1.0,
      2.0,
      4.0,
      8.0,
      12.0,
      16.0
    ],
    "depth_decays": [
      0.0,
      0.05,
      0.1,
      0.2
    ],
    "pca_dimensions": [
      128
    ],
    "cluster_counts": [
      30
    ]
  },
  "pca": {
    "enabled": true,
    "input_dim": 768,
    "output_dim": 128,
    "fit_scope": "development_only",
    "whiten": false,
    "random_state": 42,
    "fit_separately_per_variant": true
  },
  "clustering": {
    "method": "spherical_kmeans",
    "mode": "transductive",
    "n_clusters": 30,
    "seeds": [
      17,
      42,
      73
    ],
    "max_iter": 300,
    "tolerance": 0.000001,
    "n_init": 1,
    "backend": "torch",
    "device": "cuda"
  },
  "selection": {
    "primary_metric": "mean_nmi",
    "secondary_metrics": [
      "mean_predicted_cluster_purity",
      "mean_label_wise_inverse_purity"
    ],
    "select_on": "tune",
    "verify_on": "holdout",
    "maximize": true
  },
  "ablations": [
    {
      "name": "full_claimsem",
      "root_weight": 12.0,
      "depth_decay": 0.1,
      "claim_selection": "all",
      "pca_dim": 128
    },
    {
      "name": "uniform_claim_pooling",
      "root_weight": 1.0,
      "depth_decay": 0.0,
      "claim_selection": "all",
      "pca_dim": 128
    },
    {
      "name": "no_root_emphasis",
      "root_weight": 1.0,
      "depth_decay": 0.1,
      "claim_selection": "all",
      "pca_dim": 128
    },
    {
      "name": "no_depth_decay",
      "root_weight": 12.0,
      "depth_decay": 0.0,
      "claim_selection": "all",
      "pca_dim": 128
    },
    {
      "name": "root_claims_only",
      "root_weight": 1.0,
      "depth_decay": 0.0,
      "claim_selection": "roots_only",
      "pca_dim": 128
    },
    {
      "name": "first_claim_only",
      "root_weight": 1.0,
      "depth_decay": 0.0,
      "claim_selection": "first_only",
      "pca_dim": 128
    },
    {
      "name": "shuffled_dependent_depths",
      "root_weight": 12.0,
      "depth_decay": 0.1,
      "claim_selection": "all",
      "shuffle_positive_depths": true,
      "shuffle_seed": 42,
      "pca_dim": 128
    },
    {
      "name": "no_pca_reduction",
      "root_weight": 12.0,
      "depth_decay": 0.1,
      "claim_selection": "all",
      "pca_dim": null
    }
  ],
  "robustness": {
    "cluster_counts": [
      20,
      25,
      30,
      35,
      40
    ],
    "pca_dimensions": [
      64,
      96,
      128,
      192,
      256
    ]
  },
  "evaluation": {
    "label_levels": [
      "section",
      "class",
      "subclass"
    ],
    "metrics": [
      "nmi",
      "predicted_cluster_purity",
      "label_wise_inverse_purity"
    ],
    "report_mean_std": true
  },
  "runtime": {
    "resume": true,
    "overwrite": false,
    "save_manifest": true,
    "save_rankings": true,
    "save_predictions": true,
    "fail_on_data_mismatch": true
  }
}
