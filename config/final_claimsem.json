{
  "schema_version": "1.0",
  "experiment_name": "final_claimsem",
  "description": "Frozen ClaimSem configuration for final evaluation",
  "global_seed": 42,
  "paths": {
    "data_root": "${CLAIMSEM_DATA_ROOT}",
    "dev_records": "${CLAIMSEM_DATA_ROOT}/processed/dev_records.pkl",
    "test_records": "${CLAIMSEM_DATA_ROOT}/processed/test_records.pkl",
    "dev_feature_dir": "${CLAIMSEM_DATA_ROOT}/processed/token_features/full/dev",
    "test_feature_dir": "${CLAIMSEM_DATA_ROOT}/processed/token_features/full/test",
    "output_root": "${CLAIMSEM_OUTPUT_ROOT}",
    "pca_model": "${CLAIMSEM_OUTPUT_ROOT}/models/claimsem_pca128.joblib"
  },
  "data": {
    "patent_id_field": "patent_id",
    "claims_field": "claims",
    "claim_id_field": "claim_id",
    "claim_text_field": "text",
    "parent_ids_field": "parent_ids",
    "cpc_field": "cpc",
    "strict_alignment": true,
    "validate_dependencies": true,
    "remove_invalid_references": true,
    "require_acyclic_graph": true
  },
  "features": {
    "mode": "cached_shards",
    "embedding_dim": 768,
    "dtype": "float32",
    "verify_cache_provenance": true
  },
  "encoder": {
    "model_id": "${CLAIMSEM_ENCODER_ID}",
    "revision": "${CLAIMSEM_ENCODER_REVISION}",
    "frozen": true,
    "max_length": 512,
    "batch_size": 64,
    "mixed_precision": true,
    "pooling": "masked_mean",
    "output_dtype": "float32"
  },
  "pooling": {
    "method": "root_depth_aware",
    "root_weight": 12.0,
    "depth_decay": 0.1
  },
  "pca": {
    "enabled": true,
    "input_dim": 768,
    "output_dim": 128,
    "fit_split": "dev",
    "whiten": false,
    "random_state": 42,
    "refit_on_test": false
  },
  "clustering": {
    "method": "spherical_kmeans",
    "mode": "transductive",
    "n_clusters": 30,
    "seeds": [
      17,
      42,
      73
    ],
    "max_iter": 300,
    "tolerance": 0.000001,
    "n_init": 1,
    "backend": "torch",
    "device": "cuda"
  },
  "evaluation": {
    "label_levels": [
      "section",
      "class",
      "subclass"
    ],
    "metrics": [
      "nmi",
      "predicted_cluster_purity",
      "label_wise_inverse_purity"
    ],
    "report_mean_std": true,
    "save_predictions": true,
    "save_assignments": true,
    "save_per_seed_metrics": true
  },
  "expected_test_data": {
    "n_patents": 9881,
    "n_claims": 161661,
    "n_sections": 9,
    "n_classes": 121,
    "n_subclasses": 466
  },
  "expected_test_results": {
    "mean_nmi": 0.375508,
    "mean_nmi_std": 0.003952,
    "mean_predicted_cluster_purity": 0.425789,
    "mean_predicted_cluster_purity_std": 0.008153,
    "mean_label_wise_inverse_purity": 0.355812,
    "mean_label_wise_inverse_purity_std": 0.004877
  },
  "runtime": {
    "resume": true,
    "overwrite": false,
    "save_manifest": true,
    "save_checksums": true,
    "fail_on_data_mismatch": true
  }
}
